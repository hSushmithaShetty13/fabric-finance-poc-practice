table 'Source Config'

	column EntityName
		dataType: string
		isKey
		sourceColumn: EntityName

	column SourcePath
		dataType: string
		sourceColumn: SourcePath

	column FilePattern
		dataType: string
		sourceColumn: FilePattern

	column BronzeTable
		dataType: string
		sourceColumn: BronzeTable

	column SilverTable
		dataType: string
		sourceColumn: SilverTable

	column LoadMode
		dataType: string
		sourceColumn: LoadMode

	column WatermarkColumn
		dataType: string
		sourceColumn: WatermarkColumn

	column TolerancePct
		dataType: decimal
		summarizeBy: average
		sourceColumn: TolerancePct

	column IsActive
		dataType: boolean
		sourceColumn: IsActive

	column RejectPredicate
		dataType: string
		isHidden
		sourceColumn: RejectPredicate

	column RejectColumns
		dataType: string
		isHidden
		sourceColumn: RejectColumns

	partition 'Source Config' = entity
		mode: directLake
		source
			entityName: SourceConfig
			schemaName: control
			expressionSource: 'DL_WH_Finance_Gold'
