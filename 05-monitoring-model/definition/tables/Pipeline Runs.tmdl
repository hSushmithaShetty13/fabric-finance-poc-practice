table 'Pipeline Runs'

	measure 'Success Rate %' =
		DIVIDE(
			CALCULATE(COUNTROWS('Pipeline Runs'), 'Pipeline Runs'[Status] = "Succeeded"),
			COUNTROWS('Pipeline Runs')
		)
		formatString: 0.00%

	measure 'Runs Today' =
		CALCULATE(COUNTROWS('Pipeline Runs'), FILTER('Pipeline Runs', DATEVALUE('Pipeline Runs'[StartTimeUtc]) = TODAY()))
		formatString: #,##0

	measure 'Failed Runs' = CALCULATE(COUNTROWS('Pipeline Runs'), 'Pipeline Runs'[Status] = "Failed")
		formatString: #,##0

	measure 'Average Duration Seconds' = AVERAGE('Pipeline Runs'[DurationSeconds])
		formatString: #,##0.0

	measure 'Total Rows Processed' = SUM(Reconciliation[TargetRowCount])
		formatString: #,##0

	measure 'Total Rows Rejected' = SUM('Data Quality'[RowsFailed])
		formatString: #,##0

	measure 'Reconciliation Variance %' = DIVIDE(SUM(Reconciliation[VarianceRows]), SUM(Reconciliation[SourceRowCount]))
		formatString: 0.00%

	measure 'Reconciliation Breaches' = CALCULATE(COUNTROWS(Reconciliation), Reconciliation[Passed] = FALSE())
		formatString: #,##0

	measure 'Pipeline Health Status' =
		SWITCH(TRUE(), [Failed Runs] > 0, "Failed", [Reconciliation Breaches] > 0, "Needs Review", [Total Rows Rejected] > 0, "DQ Findings", "Healthy")
		formatString: @

	column RunId
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: RunId

	column ParentRunId
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: ParentRunId

	column PipelineName
		dataType: string
		sourceColumn: PipelineName

	column Environment
		dataType: string
		sourceColumn: Environment

	column LoadType
		dataType: string
		sourceColumn: LoadType

	column EntityName
		dataType: string
		sourceColumn: EntityName

	column SourceSystem
		dataType: string
		sourceColumn: SourceSystem

	column RunDate
		dataType: dateTime
		sourceColumn: RunDate

	column StartTimeUtc
		dataType: dateTime
		sourceColumn: StartTimeUtc

	column EndTimeUtc
		dataType: dateTime
		sourceColumn: EndTimeUtc

	column DurationSeconds
		dataType: int64
		isHidden
		summarizeBy: average
		sourceColumn: DurationSeconds

	column Status
		dataType: string
		sourceColumn: Status

	column ErrorMessage
		dataType: string
		sourceColumn: ErrorMessage

	column TriggeredBy
		dataType: string
		sourceColumn: TriggeredBy

	column LoggedAtUtc
		dataType: dateTime
		sourceColumn: LoggedAtUtc

	partition 'Pipeline Runs' = entity
		mode: directLake
		source
			entityName: PipelineRun
			schemaName: audit
			expressionSource: 'DL_WH_Finance_Gold'
