table Watermarks

	column EntityName
		dataType: string
		isKey
		sourceColumn: EntityName

	column WatermarkColumn
		dataType: string
		sourceColumn: WatermarkColumn

	column WatermarkValue
		dataType: string
		sourceColumn: WatermarkValue

	column LastUpdatedUtc
		dataType: dateTime
		sourceColumn: LastUpdatedUtc

	partition Watermarks = entity
		mode: directLake
		source
			entityName: Watermark
			schemaName: control
			expressionSource: 'DL_WH_Finance_Gold'
