model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures

ref table 'Pipeline Runs'
ref table 'Validation Results'
ref table 'Source Config'
ref table Watermarks

ref relationship 'Pipeline Runs to Source Config'
ref relationship 'Validation Results to Pipeline Runs'
ref relationship 'Watermarks to Source Config'
