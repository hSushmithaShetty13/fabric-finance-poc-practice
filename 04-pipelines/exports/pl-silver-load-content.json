            "end_time_utc": { "value": { "value": "@activity('Copy_Bronze_To_Silver').ExecutionEndTime", "type": "Expression" }, "type": "String" },
            "status": { "value": "Succeeded", "type": "String" },
            "rows_read": { "value": { "value": "@activity('Copy_Bronze_To_Silver').output.rowsRead", "type": "Expression" }, "type": "Int64" },
            "rows_written": { "value": { "value": "@activity('Copy_Bronze_To_Silver').output.rowsCopied", "type": "Expression" }, "type": "Int64" }
