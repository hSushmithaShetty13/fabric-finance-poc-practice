                "properties": { "annotations": [], "type": "Lakehouse", "typeProperties": {
                  "workspaceId": "ad5bf890-cd6e-4786-b69c-15876240823d",
                  "artifactId": "3dfe3fbe-4f9d-4ca2-ab91-f589b7f77533" } }
