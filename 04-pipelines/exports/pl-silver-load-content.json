      {
        "name": "Wait_SqlEndpointSync",
        "type": "Wait",
        "dependsOn": [ { "activity": "Copy_Bronze_To_Silver", "dependencyConditions": ["Succeeded"] } ],
        "typeProperties": { "waitTimeInSeconds": 90 }
      },
      {
        "name": "SCR_Classify_Rejects",
        "type": "Script",
        "dependsOn": [ { "activity": "Wait_SqlEndpointSync", "dependencyConditions": ["Succeeded"] } ],
        "policy": { "timeout": "0.02:00:00", "retry": 3, "retryIntervalInSeconds": 45, "secureOutput": false, "secureInput": false },
        "typeProperties": {
          "scripts": [
            {
              "type": "Query",
              "text": {
                "value": "@concat('INSERT INTO silver_rejects.', pipeline().parameters.p_entity_name, ' (RunId, RejectedAtUtc, RuleCode, ', activity('LKP_Config').output.firstRow.RejectColumns, ', RawRow) SELECT ''', pipeline().parameters.p_run_id, ''', SYSUTCDATETIME(), ''DQ_REJECT'', ', activity('LKP_Config').output.firstRow.RejectColumns, ', CONCAT_WS(''|'', ', activity('LKP_Config').output.firstRow.RejectColumns, ') FROM LH_Finance.dbo.', activity('LKP_Config').output.firstRow.BronzeTable, ' WHERE ', activity('LKP_Config').output.firstRow.RejectPredicate, '; DECLARE @Rejected BIGINT=(SELECT COUNT_BIG(*) FROM silver_rejects.', pipeline().parameters.p_entity_name, ' WHERE RunId=''', pipeline().parameters.p_run_id, '''); EXEC audit.SP_LogDataQuality @PipelineRunId=''', pipeline().parameters.p_run_id, ''', @EntityName=''', pipeline().parameters.p_entity_name, ''', @RuleCode=''DQ_REJECT'', @RowsFailed=@Rejected, @RuleDescription=''Configured Silver reject predicate'', @RejectTable=''silver_rejects.', pipeline().parameters.p_entity_name, ''';')",
                "type": "Expression"
              }
            }
          ],
          "scriptBlockExecutionTimeout": "0.02:00:00"
        },
        "linkedService": {
          "name": "WH_Finance_Gold",
          "properties": { "annotations": [], "type": "DataWarehouse", "typeProperties": {
            "endpoint": "xixd7xfz54kurayrqp4zf3cx3m-sd4fxllozwdepnu4cwdweqechu.datawarehouse.fabric.microsoft.com",
            "artifactId": "d88b4acf-a3ee-4568-aa66-8403b6b9ceaa",
            "workspaceId": "ad5bf890-cd6e-4786-b69c-15876240823d" } }
        }
      },
      {
        "name": "AUDIT_Silver_DQ_Success",
        "type": "SqlServerStoredProcedure",
        "dependsOn": [ { "activity": "SCR_Classify_Rejects", "dependencyConditions": ["Succeeded"] } ],
