            "datasetSettings": {
              "annotations": [],
              "type": "LakehouseTable",
              "typeProperties": { "table": { "value": "@activity('LKP_Config').output.firstRow.SilverTable", "type": "Expression" } },
              "schema": [],
              "linkedService": {
